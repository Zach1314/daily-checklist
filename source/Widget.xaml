<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="每日清单" Width="292" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display" Foreground="#F3F7F7">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#B9CBCF"/>
        <SolidColorBrush x:Key="Accent" Color="#A4E6CE"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F3F7F7"/>
            <Setter Property="Background" Value="#17FFFFFF"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#31FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#48FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F3F7F7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RowSurface" CornerRadius="7" Background="Transparent"
                                Padding="5,7,4,7" MinHeight="33">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="27"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="5"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"
                                        BorderBrush="#9EB8BC" BorderThickness="1">
                                    <Path x:Name="Tick" Data="M 3,7 L 6,10 L 11,4" Stroke="#173F36"
                                          StrokeThickness="1.5" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                </Border>
                                <TextBlock x:Name="Label" Grid.Column="1" Text="{TemplateBinding Content}"
                                           FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="#19FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Card" CornerRadius="15" Background="#C718272D"
            BorderBrush="#70A8C9C5" BorderThickness="1" Padding="14,13,14,12">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Button x:Name="MenuButton" DockPanel.Dock="Right" Width="29" Height="26"
                        VerticalAlignment="Top" Padding="0" ToolTip="窗口设置"
                        AutomationProperties.Name="窗口设置">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Fill="#CFDEDC" Width="3" Height="3"/>
                        <Ellipse Fill="#CFDEDC" Width="3" Height="3" Margin="3,0"/>
                        <Ellipse Fill="#CFDEDC" Width="3" Height="3"/>
                    </StackPanel>
                </Button>
                <Grid x:Name="DragHandle" Background="Transparent" Margin="0,0,7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="9" HorizontalAlignment="Left"
                            Background="#28A4E6CE" VerticalAlignment="Center">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 4,2 H 13 V 14 H 3 V 2 Z M 6,1 V 4 M 10,1 V 4 M 5.5,8 L 7.5,10 L 11,6.5"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="每日清单" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DateLabel" Margin="0,2,0,0" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
            <Border Height="1" Background="#33C8DFDC" Margin="0,11,0,7"/>
            <StackPanel x:Name="ListView">
                <TextBlock x:Name="EmptyText" Text="点「编辑清单」添加每天要做的事"
                           TextWrapping="Wrap" Margin="5,8,5,11" Foreground="{StaticResource Muted}"/>
                <ScrollViewer x:Name="TaskScroll" MaxHeight="260"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Rows"/>
                </ScrollViewer>
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button x:Name="EditButton" DockPanel.Dock="Right" Content="编辑清单"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,6,0">
                        <Border Width="44" Height="3" Background="#42D5E8E5" CornerRadius="1.5">
                            <Border x:Name="Progress" Width="0" HorizontalAlignment="Left"
                                    Background="{StaticResource Accent}" CornerRadius="1.5"/>
                        </Border>
                        <TextBlock x:Name="CountLabel" Margin="8,0,0,0" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
            <StackPanel x:Name="EditorView" Visibility="Collapsed" Margin="0,3,0,0">
                <TextBlock Text="每行一项，清单每天重复" Foreground="{StaticResource Muted}"
                           Margin="0,0,0,7"/>
                <TextBox x:Name="Editor" Height="148" Padding="7,6"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="工作清单，每行一项"
                         FontSize="13" Background="#58202F34" Foreground="#F3F7F7"
                         CaretBrush="#F3F7F7" BorderBrush="#80A8C9C5" BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                    <Button x:Name="CancelButton" Content="取消" Background="Transparent" Margin="0,0,6,0"/>
                    <Button x:Name="SaveButton" Content="保存清单" Background="#3DA4E6CE"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
